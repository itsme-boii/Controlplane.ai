# Copy to .env and fill in. .env is git-ignored.

# --- Foundation-model backend (Phase 1: Groq) ---
# Provider selector: currently only "groq" is implemented.
MODEL_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Default model used when a request does not name one.
GROQ_MODEL=openai/gpt-oss-20b

# --- Datastores (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://controlplane:controlplane@postgres:5432/controlplane
REDIS_URL=redis://redis:6379/0

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO
# Policy packs directory. In Docker this is /app/policies (set by compose);
# for a host run point it at the repo's ./policies.
POLICIES_DIR=policies

# --- Judge detector (Phase 5) ---
# Leave unset (don't write "JUDGE_MODEL=" — an empty value would override
# the code's own fallback to GROQ_MODEL with an empty string). Uncomment
# and set only to use a different model for the judge than the main chat.
# JUDGE_MODEL=openai/gpt-oss-20b
JUDGE_CACHE_TTL_S=86400

# --- Conversation risk ledger (Phase 5) ---
LEDGER_ENABLED=true
LEDGER_TTL_SECONDS=86400
LEDGER_DECAY=0.85
LEDGER_ESCALATION_THRESHOLD=1.2

# --- Action gate (Phase 6) ---
# Free sandbox tier at https://mailtrap.io -> Email Testing -> Sandbox.
# Required for /v1/actions/execute (send_email) to actually deliver; without
# these an "allow" action decision still fails at Mailtrap with 401 (real
# failure, not a fake success) rather than reaching an inbox.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
